{
  "expo": {
    "name": "Veracity",
    "slug": "veracity",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAF8"
    },
    "android": {
      "package": "io.zaaka.veracity",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#FAFAF8"
      },
      "permissions": ["android.permission.CAMERA"],
      "intentFilters": [
        {
          "action": "SEND",
          "data": [{ "mimeType": "image/*" }],
          "category": ["DEFAULT"]
        }
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Veracity reads the screenshot you pick, then discards it.",
          "cameraPermission": "Veracity uses the camera to capture a screen in front of you."
        }
      ]
    ]
  }
}
